{
  "manifest_version": 3,
  "name": "10xapply bridge",
  "version": "0.0.1",
  "description": "Lets the local 10xapply runner drive windows this extension opens itself.",
  "permissions": ["debugger", "tabs", "alarms", "scripting"],
  "host_permissions": [
    "https://www.linkedin.com/jobs/*",
    "https://deviceandbrowserinfo.com/are_you_a_bot_interactions*",
    "https://bot.incolumitas.com/*",
    "http://127.0.0.1/*"
  ],
  "action": {},
  "background": { "service_worker": "background.js", "type": "module" }
}
