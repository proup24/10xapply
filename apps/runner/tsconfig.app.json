{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "out-tsc/app",
    "types": ["node"],
    "rootDir": "src",
    "tsBuildInfoFile": "out-tsc/app/tsconfig.app.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "out-tsc",
    "dist",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/testing/**/*.ts",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "../../libs/answerer/tsconfig.lib.json"
    },
    {
      "path": "../../libs/fact-bank/tsconfig.lib.json"
    }
  ]
}
