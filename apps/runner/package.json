{
  "name": "@xapply/runner",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "targets": {
      "session": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/runner",
          "command": "tsx src/main.ts session"
        }
      },
      "bot-check": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/runner",
          "command": "tsx src/main.ts bot-check"
        }
      },
      "bot-check-repeat": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/runner",
          "command": "tsx src/main.ts bot-check --repeat 3 --record"
        }
      },
      "bridge-install": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/runner",
          "command": "tsx src/main.ts bridge install"
        }
      },
      "bridge-check": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/runner",
          "command": "tsx src/main.ts bridge check"
        }
      },
      "bridge-check-crash": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/runner",
          "command": "tsx src/main.ts bridge check --crash"
        }
      },
      "pace-record": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/runner",
          "command": "tsx src/main.ts pace record"
        }
      },
      "pace-record-typing": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/runner",
          "command": "tsx src/main.ts pace record --typing"
        }
      },
      "pace-practice": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/runner",
          "command": "tsx src/main.ts pace practice --runs 5 --record"
        }
      },
      "pace-build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/runner",
          "command": "tsx src/main.ts pace build"
        }
      },
      "pace-summary": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/runner",
          "command": "tsx src/main.ts pace summary"
        }
      },
      "facts-check": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build"
        ],
        "options": {
          "cwd": "apps/runner",
          "command": "tsx src/main.ts facts check"
        }
      },
      "pace-compare": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/runner",
          "command": "tsx src/main.ts pace compare"
        }
      }
    }
  },
  "dependencies": {
    "@xapply/fact-bank": "workspace:*",
    "patchright-core": "1.64.3",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "linkedom": "^0.18.15",
    "tsx": "^4.23.15"
  }
}
