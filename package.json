{
  "name": "@xapply/source",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "scripts": {
    "test:hooks": "node --test \".claude/hooks/*.test.mjs\"",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "db:start": "scripts/ensure-signing-key.sh && supabase start",
    "db:test": "nx run-many -t db-test -p @xapply/db-tests @xapply/api",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:types": "supabase gen types typescript --local --schema public > libs/database/src/supabase/database.types.ts && prettier --write libs/database/src/supabase/database.types.ts",
    "db:migrate": "pnpm --filter @xapply/database db:migrate",
    "db:seed": "pnpm --filter @xapply/database db:seed",
    "db:reset": "supabase stop --no-backup && scripts/ensure-signing-key.sh && supabase start && XAPPLY_SKIP_ENV_FILES=1 DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres pnpm --filter @xapply/database db:migrate && eval \"$(scripts/supabase-env.sh)\" && XAPPLY_SKIP_ENV_FILES=1 DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres pnpm --filter @xapply/database db:seed"
  },
  "private": true,
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/docker": "24.0.2",
    "@nx/eslint": "24.0.2",
    "@nx/eslint-plugin": "24.0.2",
    "@nx/js": "24.0.2",
    "@nx/nest": "24.0.2",
    "@nx/node": "24.0.2",
    "@nx/vitest": "24.0.2",
    "@nx/web": "24.0.2",
    "@nx/webpack": "24.0.2",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "~5.0.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "24.0.2",
    "prettier": "^3.8.1",
    "supabase": "3.0.0-next.27",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "~5.0.1",
    "webpack": "~5.110.0",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "packageManager": "pnpm@12.15.0"
}
