# Copy to .env and fill in. Placeholders only; never commit real values.

# Local Supabase stack (pnpm db:start). Safe to leave as is.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Cloud project: the URL's shape only. Do not fill it in on this machine.
# CI holds the real URL and is the only thing that migrates the cloud project;
# keeping it out of .env is what stops a local command from reaching it.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
