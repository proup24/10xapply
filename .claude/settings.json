{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "nx-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "nrwl/nx-ai-agents-config"
      }
    }
  },
  "enabledPlugins": {
    "nx@nx-claude-plugins": true
  },
  "permissions": {
    "allow": [
      "Bash(pnpm nx lint:*)",
      "Bash(pnpm nx test:*)",
      "Bash(pnpm nx typecheck:*)",
      "Bash(pnpm nx build:*)",
      "Bash(pnpm nx run-many:*)",
      "Bash(pnpm nx affected:*)",
      "Bash(pnpm test:hooks)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list:*)",
      "Bash(git branch -a)",
      "Bash(git branch -v)",
      "Bash(git branch -vv)"
    ],
    "ask": ["Bash(git push:*)", "Bash(gh pr create:*)"],
    "deny": ["Read(./.env)", "Read(./.env.local)", "Read(./private/**)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|MultiEdit|Write|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\""
          }
        ]
      }
    ]
  }
}
